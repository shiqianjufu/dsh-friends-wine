{
  "name": "dsh-friends-wine",
  "version": "1.0.4",
  "type": "module",
  "license": "MIT",
  "description": "Stretches the whole DSH UI and bounces the native window while the agent works; plays a user-supplied local song, never a bundled recording.",
  "repository": {
    "type": "git",
    "url": "https://github.com/shiqianjufu/dsh-friends-wine.git"
  },
  "homepage": "https://github.com/shiqianjufu/dsh-friends-wine",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.webp"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/window-bounce.ps1",
    "icon.webp",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "install.mjs"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
